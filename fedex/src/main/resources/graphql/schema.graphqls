enum Role {
    USER
    ADMIN
}

type User {
    id: ID!
    username: String!
    email: String!
    roles: [Role!]!
}

type AuthPayload {
    token: String!
    user: User!
}

type Query {
    currentUser: User!
    users: [User!]!
    roles: [Role!]!
}

type Mutation {
    signIn(input: SignInInput!): AuthPayload!
    signUp(input: SignUpInput!): String!
    updateUserRoles(id: ID!, roles: [Role!]!): User!
    deleteUser(id: ID!): Boolean!
}

input SignInInput {
    username: String!
    password: String!
}

input SignUpInput {
    username: String!
    email: String!
    password: String!
    roles: [Role!]
}