enum Role {
    USER
    ADMIN
}

type User {
    id: ID!
    username: String!
    email: String!
    roles: [Role!]!
}

type AuthPayload {
    token: String!
    user: User!
}

type Query {
    currentUser: User!
    users: [User!]!
    roles: [Role!]!
    allShippingDetails: [ShippingDetails!]!
    shippingDetailsById(id: ID!): ShippingDetails
    shippingDetailsByTrackingNumber(trackingNumber: String!): ShippingDetails
    searchShippingByFirstName(firstName: String!): [ShippingDetails!]!
    shippingByDeliveryMode(deliveryMode: DeliveryMode!): [ShippingDetails!]!

    # Shipment Details Given Formate
    allPricePlanDetails: [PricePlanResponse]!
    getPricePlanDetailById: PricePlanResponse

}

type Mutation {
    signIn(input: SignInInput!): AuthPayload!
    signUp(input: SignUpInput!): SignUpResponse!
    updateUserRoles(id: ID!, roles: [Role!]!): User!
    deleteUser(id: ID!): Boolean!
    createShippingDetails(input: ShippingInput!): ShippingDetails!
    updateShippingDetails(id: ID!, input: ShippingInput!): ShippingDetails!
    deleteShippingDetails(id: ID!): Boolean!

#    Shipment Details Given Formate
    createPlanPriceDetails(input: PricePlanInput!): PricePlanResponse!
    updatePricePlanDetails(input: PricePlanInput!): PricePlanResponse!
    deletePricePlanDetails(id: Int!): Boolean!
}

input PricePlanInput {
    planId: Int!,
    pricingPlanId: Int!,
    detailId: Int!,
    fromWeight: String!,
    toWeight: String!,
    price: Float!
}

type PricePlanResponse {
    planId: Int!,
    pricingPlanId: Int!,
    detailId: Int!,
    fromWeight: String!,
    toWeight: String!,
    price: Float!
}

input PlanCountry {
    pricingPlanId: Int!
    countryCode:String!
}

type PricePlanCountry {
    Plan_id:Int!
    PricingPlanId:Int!
    CountryCode:String!
}

input SignInInput {
    username: String!
    password: String!
}

input SignUpInput {
    username: String!
    email: String!
    password: String!
    roles: [Role!]
}

type SignUpResponse {
    message: String
    success: Boolean!
    error: String
}

type ShippingDetails {
    id: ID!
    senderFirstName: String!
    senderLastName: String!
    senderEmail: String!
    senderContactNumber: String!
    senderAddress: String!
    receiverFirstName: String!
    receiverLastName: String!
    receiverEmail: String!
    receiverContactNumber: String!
    receiverAddress: String!
    deliveryMode: DeliveryMode!
    price: Float!
    shippingStatus: ShippingStatus!
    trackingNumber: String!
    createdAt: String!
    updatedAt: String!
}

input ShippingInput {
    senderFirstName: String!
    senderLastName: String!
    senderEmail: String!
    senderContactNumber: String!
    senderAddress: String!
    receiverFirstName: String!
    receiverLastName: String!
    receiverEmail: String!
    receiverContactNumber: String!
    receiverAddress: String!
    deliveryMode: DeliveryMode!
    price: Float!
    shippingStatus: ShippingStatus!
}

enum DeliveryMode {
    EXPRESS,
    STANDARD,
    ECONOMY,
    INTERNATIONAL,
    SAME_DAY,
    OVERNIGHT,
    FREIGHT,
    GROUND
}

enum ShippingStatus {
    PENDING,
    PICKED_UP,
    IN_TRANSIT,
    OUT_FOR_DELIVERY,
    DELIVERED,
    FAILED_DELIVERY,
    RETURNED,
    CANCELLED,
    ON_HOLD,
    CUSTOMS_CLEARANCE,
    EXCEPTION
}
